FROM node:22-alpine AS build
WORKDIR /app
COPY hemasight/frontend/react-dashboard/package*.json ./
RUN npm ci
COPY hemasight/frontend/react-dashboard/ .
ENV VITE_API_URL=/api
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY hemasight/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
